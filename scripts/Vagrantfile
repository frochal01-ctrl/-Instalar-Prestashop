Vagrant.configure("2") do |config|
  config.vm.box = "debian/bookworm64"

  # 1. Capa 3: Base de Datos (PRIMERO para que esté lista antes que los Apache)
  config.vm.define "mysql" do |mysql|
    mysql.vm.hostname = "FranciscoRochaMysql"
    mysql.vm.network "private_network", ip: "192.168.20.20", virtualbox__intnet: "red_capa2_capa3"
    mysql.vm.provision "shell", path: "pmysql.sh"

    mysql.vm.provider "virtualbox" do |vb|
      vb.name = "FranciscoRochaMysql"
      vb.memory = "2048"
      vb.cpus = 1
    end
  end

  # 2. Capa 2: Servidor Web 1 (Instala PrestaShop en BD y guarda copia en /vagrant)
  config.vm.define "apache1" do |apache1|
    apache1.vm.hostname = "FranciscoRochaApache1"
    apache1.vm.network "private_network", ip: "192.168.10.11", virtualbox__intnet: "red_capa1_capa2"
    apache1.vm.network "private_network", ip: "192.168.20.11", virtualbox__intnet: "red_capa2_capa3"
    apache1.vm.provision "shell", path: "papache.sh"
    apache1.vm.provision "shell", path: "pprestashop.sh", args: ["instalar"]

    apache1.vm.provider "virtualbox" do |vb|
      vb.name = "FranciscoRochaApache1"
      vb.memory = "2048"
      vb.cpus = 1
    end
  end

  # 3. Capa 2: Servidor Web 2 (Clona la instalación ya hecha en apache1)
  config.vm.define "apache2" do |apache2|
    apache2.vm.hostname = "FranciscoRochaApache2"
    apache2.vm.network "private_network", ip: "192.168.10.12", virtualbox__intnet: "red_capa1_capa2"
    apache2.vm.network "private_network", ip: "192.168.20.12", virtualbox__intnet: "red_capa2_capa3"
    apache2.vm.provision "shell", path: "papache.sh"
    apache2.vm.provision "shell", path: "pprestashop.sh", args: ["secundario"]

    apache2.vm.provider "virtualbox" do |vb|
      vb.name = "FranciscoRochaApache2"
      vb.memory = "2048"
      vb.cpus = 1
    end
  end

  # 4. Capa 1: Balanceador (Red Pública / NAT + Red Capa 1)
  config.vm.define "balanceador" do |bal|
    bal.vm.hostname = "FranciscoRochaBalanceador"
    bal.vm.network "forwarded_port", guest: 80, host: 8080
    bal.vm.network "forwarded_port", guest: 443, host: 8443
    bal.vm.network "private_network", ip: "192.168.10.10", virtualbox__intnet: "red_capa1_capa2"
    bal.vm.provision "shell", path: "pbalanceador.sh"

    bal.vm.provider "virtualbox" do |vb|
      vb.name = "FranciscoRochaBalanceador"
      vb.memory = "1024"
      vb.cpus = 1
    end
  end
end









